# Postgres DB configuration
POSTGRES_USER=leados_user
POSTGRES_PASSWORD=leados_password
POSTGRES_DB=leados_db

# FastAPI Backend configuration
DATABASE_URL=postgresql://leados_user:leados_password@postgres:5432/leados_db

# Next.js Frontend configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# n8n Orchestrator configuration
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
NODE_ENV=production
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=UTC
