# Postgres DB configuration
POSTGRES_USER=leados_user
POSTGRES_PASSWORD=placeholder_password
POSTGRES_DB=leados_db

# FastAPI Backend configuration
DATABASE_URL=postgresql://leados_user:placeholder_password@postgres:5432/leados_db
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=60
INTERNAL_API_KEY=change-me-to-a-long-random-string
ENCRYPTION_KEY=change-me-to-a-secure-fernet-key

# Seed admin user (backend/app/db/seed.py) — override before running in
# anything beyond local dev.
ADMIN_EMAIL=admin@sanestix.com
ADMIN_PASSWORD=ChangeMe123!

# Next.js Frontend configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# n8n Orchestrator configuration
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
NODE_ENV=production
WEBHOOK_URL=http://localhost:5678/
N8N_RUN_CAMPAIGN_WEBHOOK_URL=http://n8n:5678/webhook/run_campaign
GENERIC_TIMEZONE=UTC
